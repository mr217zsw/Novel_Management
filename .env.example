APP_NAME="Novel Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost
APP_LOCALE=zh_CN

# ============ 数据库 ============
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=novel_platform
DB_USERNAME=root
DB_PASSWORD=

# ============ Redis ============
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_DB=0
REDIS_CACHE_DB=1

# ============ 缓存 / 队列 ============
CACHE_STORE=redis
QUEUE_CONNECTION=sync

# ============ 会话 ============
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ============ 日志 ============
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ============ JWT 认证 ============
JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# ============ 阿里云 OSS / STS ============
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_INTERNAL_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
OSS_CDN_DOMAIN=
OSS_STS_ROLE_ARN=
OSS_STS_REGION=cn-hangzhou
OSS_STS_DURATION=1800
OSS_PART_SIZE=5242880
OSS_MAX_CONCURRENCY=3
RAM_ACCOUNT_ID=
RAM_ROLE_NAME=oss-uploader-role

# ============ 支付配置 ============
PAYMENT_MOCK_ENABLED=true
PAYMENT_ORDER_EXPIRE=15

# 微信支付
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_CERT_SERIAL_NO=
WECHAT_NOTIFY_URL=

# 抖音支付
DOUYIN_APP_ID=
DOUYIN_MCH_ID=
DOUYIN_SALT=
DOUYIN_NOTIFY_URL=
DOUYIN_VIRTUAL_NOTIFY_URL=

# 苹果 IAP
APPLE_BUNDLE_ID=
APPLE_SHARED_SECRET=
APPLE_ENV=sandbox

# ============ 腾讯云（内容审核） ============
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# ============ 短信服务 ============
SMS_PROVIDER=aliyun
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ============ 模拟模式开关（本地开发） ============
AUDIT_MOCK_ENABLED=true
PAYMENT_MOCK_ENABLED=true
SMS_MOCK_ENABLED=true
QUEUE_MOCK_ENABLED=true
OSS_MOCK_ENABLED=true

# ============ 其他 ============
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
